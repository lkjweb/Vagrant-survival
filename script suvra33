local function UpdESP(part, txt, ty, id)
    local uName = "ESP_" .. ty .. "_" .. tostring(id); local bg = part:FindFirstChild(uName)
    if not bg then
        bg = Instance.new("BillboardGui"); bg.Name = uName; bg.AlwaysOnTop = true; bg.Size = UDim2.new(0, 140, 0, 45); bg.StudsOffset = Vector3.new(0, 3, 0)
        local l = Instance.new("TextLabel", bg); l.Name = "EspLabel"; l.BackgroundTransparency = 1; l.Size = UDim2.new(1, 0, 1, 0); l.TextSize = 11; l.Font = Enum.Font.Code
        l.TextColor3 = (ty == "P") and Color3.fromRGB(0, 255, 150) or ((ty == "W") and Color3.fromRGB(255, 100, 100) or Color3.fromRGB(255, 210, 0))
        bg.Parent = part
    end
    bg.Enabled = true; if bg:FindFirstChild("EspLabel") then bg.EspLabel.Text = txt end
end

local function ClearESP(part, ty, id) if part then local bg = part:FindFirstChild("ESP_" .. ty .. "_" .. tostring(id)) if bg then bg:Destroy() end end end

local ActiveBackpacks = {}
local function DeepScan(root)
    local found = {}
    local function search(cur, depth)
        if depth > 4 or not cur then return end
        for _, o in ipairs(cur:GetChildren()) do
            if o.Name:lower():find("backpack") or o.Name:lower():find("bag") or o:FindFirstChild("Loot") then
                local p = o:IsA("BasePart") and o or o:FindFirstChildOfClass("BasePart")
                if p then table.insert(found, {obj = o, part = p}) end
            end
            if o:IsA("Folder") or o:IsA("Model") then search(o, depth + 1) end
        end
    end
    search(root, 1) return found
end

local function ScanBackpacks()
    if not Config.EB then return end
    local CurrentBags = {}
    local bags = DeepScan(workspace)
    for _, data in ipairs(bags) do CurrentBags[data.obj] = data.part; ActiveBackpacks[data.obj] = data.part; UpdESP(data.part, "🎒 Loot Backpack", "L", tostring(data.obj)) end
    for obj, part in pairs(ActiveBackpacks) do if not CurrentBags[obj] then pcall(function() ClearESP(part, "L", tostring(obj)) end); ActiveBackpacks[obj] = nil end end
end

task.spawn(function() while true do task.wait(2.0); pcall(ScanBackpacks) end end)

local PlayerPartsCache = {}
local lastEspTime = 0
RS.Heartbeat:Connect(function()
    local now = os.clock(); if now - lastEspTime < 0.03 then return end lastEspTime = now
    local mr = LP.Character and LP.Character:FindFirstChild("HumanoidRootPart")
    if mr then
        for _, p in pairs(Plrs:GetPlayers()) do

if p ~= LP then
                if p.Character and p.Character:FindFirstChild("HumanoidRootPart") and p.Character:FindFirstChild("Humanoid") then
                    local hrp, hum, tl = p.Character.HumanoidRootPart, p.Character.Humanoid, p.Character:FindFirstChildOfClass("Tool")
                    PlayerPartsCache[p.UserId] = hrp
                    if hum.Health > 0 then
                        if Config.EP and Camera then UpdESP(hrp, p.Name .. " [" .. math.floor(hum.Health) .. "HP] (" .. math.floor((mr.Position - hrp.Position).Magnitude / 3.5) .. "m)", "P", p.UserId) else ClearESP(hrp, "P", p.UserId) end
                        if Config.EW then if tl then UpdESP(hrp, "\n\nWeapon: " .. tl.Name, "W", p.UserId) else ClearESP(hrp, "W", p.UserId) end else ClearESP(hrp, "W", p.UserId) end
                    else ClearESP(hrp, "P", p.UserId); ClearESP(hrp, "W", p.UserId) end
                else
                    local cached = PlayerPartsCache[p.UserId]; if cached then ClearESP(cached, "P", p.UserId); ClearESP(cached, "W", p.UserId); PlayerPartsCache[p.UserId] = nil end
                end
            end
        end
    end
    if not Config.EB then for obj, part in pairs(ActiveBackpacks) do pcall(function() ClearESP(part, "L", tostring(obj)) end) end; ActiveBackpacks = {} end
end)

