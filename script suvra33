local function IsVis(char)
    local h = char:FindFirstChild("Head")
    if not h then return false end
    local p = RaycastParams.new(); p.FilterType = Enum.RaycastFilterType.Exclude; p.FilterDescendantsInstances = {LP.Character, char, Cam}
    return workspace:Raycast(Cam.CFrame.Position, h.Position - Cam.CFrame.Position, p) == nil
end

local function GetTarget()
    local t, maxD, mPos = nil, C.FR, UIS:GetMouseLocation()
    for _, p in pairs(Plrs:GetPlayers()) do
        if p ~= LP and p.Character and p.Character:FindFirstChild("Head") and p.Character:FindFirstChild("Humanoid") and p.Character.Humanoid.Health > 0 then
            local sPos, onS = Cam:WorldToScreenPoint(p.Character.Head.Position)
            if onS then
                local d = (Vector2.new(sPos.X, sPos.Y) - mPos).Magnitude
                if d < maxD then t, maxD = p, d end
            end
        end
    end
    return t
end

local oldNamecall
local function Init(isMob)
    RS.RenderStepped:Connect(function()
        if FC.Visible then
            FC.Position = UDim2.fromOffset(UIS:GetMouseLocation().X, UIS:GetMouseLocation().Y)
            local t = GetTarget()
            local clr = (t and t.Character and IsVis(t.Character)) and Color3.fromRGB(0,255,136) or Color3.fromRGB(255,75,75)
            FC.BackgroundColor3 = clr; FB.Color = clr
        end
    end)
    if isMob then
        RS.RenderStepped:Connect(function()
            if C.SA and UIS:IsMouseButtonPressed(Enum.MouseButton.LeftParameter) then
                local t = GetTarget()

if t and t.Character and t.Character:FindFirstChild("Head") and IsVis(t.Character) then Cam.CFrame = CFrame.new(Cam.CFrame.Position, t.Character.Head.Position) end
            end
        end)
    else
        oldNamecall = hookmetamethod(game, "__namecall", function(Self, ...)
            local m, args = getnamecallmethod(), {...}
            if C.SA and not checkcaller() and (m == "FindPartOnRayWithIgnoreList" or m == "FindPartOnRay" or m == "Raycast") then
                local t = GetTarget()
                if t and t.Character and t.Character:FindFirstChild("Head") and IsVis(t.Character) then
                    if m == "Raycast" then args = (t.Character.Head.Position - args).Unit * 1000 else args = Ray.new(Cam.CFrame.Position, (t.Character.Head.Position - Cam.CFrame.Position).Unit * 1000) end
                end
            end
            return oldNamecall(Self, unpack(args))
        end)
    end
    RS.Heartbeat:Connect(function()
        local t = LP.Character and LP.Character:FindFirstChildOfClass("Tool")
        if t and (C.NR or C.NS) then
            for _, o in pairs(t:GetDescendants()) do
                if o:IsA("ValueBase") or o:IsA("NumberValue") then
                    local n = o.Name:lower()
                    if C.NR and (n:find("recoil") or n:find("kick") or n:find("shak")) then o.Value = 0 end
                    if C.NS and (n:find("spread") or n:find("acc") or n:find("disp")) then o.Value = 0 end
                end
            end
        end
        if C.SH and LP.Character and LP.Character:FindFirstChild("HumanoidRootPart") and LP.Character:FindFirstChild("Humanoid") and LP.Character.Humanoid.MoveDirection.Magnitude > 0 then
            LP.Character.HumanoidRootPart.AssemblyLinearVelocity = Vector3.new(LP.Character.Humanoid.MoveDirection.X * 26, LP.Character.HumanoidRootPart.AssemblyLinearVelocity.Y, LP.Character.Humanoid.MoveDirection.Z * 26)
        end
    end)
    task.spawn(function()
        while true do
            task.wait(0.04)
            if C.AF and LP.Character and LP.Character:FindFirstChild("HumanoidRootPart") then
                local t = GetTarget()
                if t and t.Character and t.Character:FindFirstChild("Head") and IsVis(t.Character) and (LP.Character.HumanoidRootPart.Position - t.Character.Head.Position).Magnitude <= 1750 then
                    local tl = LP.Character:FindFirstChildOfClass("Tool")
                    if tl then tl:Activate(); task.wait(0.02); tl:Deactivate() end
                end
            end
        end
    end)
    UIS.JumpRequest:Connect(function()
        if C.IJ and LP.Character and LP.Character:FindFirstChildOfClass("Humanoid") then LP.Character:FindFirstChildOfClass("Humanoid"):ChangeState(Enum.HumanoidStateType.Jumping) end
    end)
    local PCache, LCache = {}, {}
    local function UpdESP(part, txt, ty, id)
        local cache = (ty == "P") and PCache or LCache
        local bg = cache[id]
        if not bg or not bg.Parent then
            if bg then bg:Destroy() end
            bg = Instance.new("BillboardGui", part); bg.AlwaysOnTop = true; bg.Size = UDim2.new(0,140,0,35); bg.StudsOffset = Vector3.new(0,3,0)
            local l = Instance.new("TextLabel", bg); l.Name = "L"; l.BackgroundTransparency = 1; l.Size = UDim2.new(1,0,1,0); l.TextSize = 11; l.Font = Enum.Font.Code; l.TextColor3 = (ty == "P") and Color3.fromRGB(0,255,150) or Color3.fromRGB(255,210,0)
            cache[id] = bg
        end
        bg.Enabled = true; bg.L.Text = txt
    end
    RS.Heartbeat:Connect(function()
        if C.EP or C.EW then
            for _, p in pairs(Plrs:GetPlayers()) do
                if p ~= LP and p.Character and p.Character:FindFirstChild("HumanoidRootPart") and p.Character:FindFirstChild("Humanoid") and p.Character.Humanoid.Health > 0 then

local d = math.floor((LP.Character.HumanoidRootPart.Position - p.Character.HumanoidRootPart.Position).Magnitude / 3.5)
                    local tl = p.Character:FindFirstChildOfClass("Tool")
                    local str = (C.EP and p.Name.." ["..math.floor(p.Character.Humanoid.Health).."HP] ("..d.."m)" or "")..(C.EW and "\n"..(tl and tl.Name or "Fists") or "")
                    UpdESP(p.Character.HumanoidRootPart, str, "P", p.UserId)
                elseif PCache[p.UserId] then PCache[p.UserId].Enabled = false end
            end
        else for _, g in pairs(PCache) do g.Enabled = false end end
        if C.EB then
            for _, o in pairs(workspace:GetChildren()) do
                if o.Name:lower():find("backpack") or o.Name:lower():find("bag") or o:FindFirstChild("Loot") then
                    local p = o:IsA("BasePart") and o or o:FindFirstChildOfClass("BasePart")
                    if p then UpdESP(p, "🎒 Loot Backpack", "L", o:GetDebugId()) end
                end
            end
        else for _, g in pairs(LCache) do g.Enabled = false end end
    end)
end

