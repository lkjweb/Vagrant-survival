local Params = RaycastParams.new(); Params.FilterType = Enum.RaycastFilterType.Exclude
workspace:GetPropertyChangedSignal("CurrentCamera"):Connect(function() Camera = workspace.CurrentCamera or workspace:FindFirstChildOfClass("Camera") end)

local function IsVis(char)
    if not char or not LP.Character or not Camera then return false end
    local h, mh = char:FindFirstChild("Head"), LP.Character:FindFirstChild("Head")
    if not h or not mh then return false end
    Params.FilterDescendantsInstances = {LP.Character, char, Camera}
    return workspace:Raycast(Camera.CFrame.Position, h.Position - Camera.CFrame.Position, Params) == nil
end

local ActiveTouches = {}
UIS.TouchStarted:Connect(function(touch, processed) if not processed then table.insert(ActiveTouches, touch) end end)
UIS.TouchEnded:Connect(function(touch) for i, t in ipairs(ActiveTouches) do if t == touch then table.remove(ActiveTouches, i) break end end end)

local function GetInputPosition()
    local primary = ActiveTouches[1]
    if primary then return Vector2.new(primary.Position.X, primary.Position.Y) end
    return UIS:GetMouseLocation()
end

local function GetTarget()
    local t, maxD, mPos = nil, Config.FR, GetInputPosition()
    if not Camera then return nil end
    for _, p in pairs(Plrs:GetPlayers()) do
        if p ~= LP and p.Character then
            local h, hum = p.Character:FindFirstChild("Head"), p.Character:FindFirstChildOfClass("Humanoid")
            if h and hum and hum.Health > 0 then
                local sPos, onS = Camera:WorldToScreenPoint(h.Position)
                if onS then local d = (Vector2.new(sPos.X, sPos.Y) - mPos).Magnitude; if d < maxD then t, maxD = p, d end end
            end
        end
    end
    return t
end

